# ---------------------------------------------------------------------------
# PhyBot configuration
# Copy this file to ".env" and fill in the values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Discord (required) ----------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=
# Application ID from the same page (General Information -> Application ID)
DISCORD_CLIENT_ID=
# Your own Discord user ID. Owner-only commands and the dashboard use it.
DISCORD_OWNER_ID=
# Optional: register slash commands instantly in this one guild during
# development. Leave empty to register them globally (can take up to an hour).
DISCORD_DEV_GUILD_ID=

# --- Web dashboard ---------------------------------------------------------
# Port and host for the dashboard / API server.
WEB_PORT=8420
# 127.0.0.1 keeps the dashboard on this machine. Use 0.0.0.0 to reach it from
# another computer on the network, which also requires DASHBOARD_PASSWORD.
WEB_HOST=127.0.0.1
# Password used to sign in to the dashboard. Choose a long, unique value.
DASHBOARD_PASSWORD=change-me-before-first-run
# Allows listening on a non-loopback address with no password set. This puts an
# unprotected dashboard on the network; leave it off unless something else is
# already restricting access.
ALLOW_INSECURE_DASHBOARD=false
# Secret used to sign session cookies. Leave empty to auto-generate one and
# store it under the data directory.
SESSION_SECRET=

# --- Storage / runtime -----------------------------------------------------
# Directory for the SQLite database, caches and downloaded assets.
DATA_DIR=./data
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# IANA timezone used for scheduled events and reminders.
TIMEZONE=Europe/Istanbul

# --- Music -----------------------------------------------------------------
# Optional Spotify credentials (free developer app). Spotify no longer lets
# applications read playlists on their own, so link your own account once from
# the dashboard (Overview -> Spotify) to import playlists completely. Without
# the link, playlists are read from the public page and stop at 100 tracks.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a redirect URI registered in your Spotify application. Leave empty
# to use http://<WEB_HOST>:<WEB_PORT>/api/spotify/callback.
SPOTIFY_REDIRECT_URI=
# Optional path to a Netscape cookies.txt export, used by yt-dlp for
# age-restricted or region-locked videos.
# Only needed where the bundled ffmpeg cannot run, such as Alpine
FFMPEG_PATH=
# Set to true when playback fails with an I/O error on a machine with IPv6
YOUTUBE_FORCE_IPV4=false
YOUTUBE_COOKIES_FILE=
# Default playback volume in percent (0-200).
MUSIC_DEFAULT_VOLUME=100
# Seconds of inactivity before the bot leaves an empty voice channel.
MUSIC_IDLE_TIMEOUT_SECONDS=300

# --- AI assistant (all options below have free tiers) ----------------------
# Text/intent model provider: gemini | groq | ollama | none
AI_PROVIDER=none
# Speech-to-text provider: gemini | groq | none
AI_STT_PROVIDER=none
# https://aistudio.google.com/apikey  (free tier, no card required)
GEMINI_API_KEY=
# The alias always points at the current Flash model, so a retired model
# name cannot break the assistant.
GEMINI_MODEL=gemini-flash-latest
# https://console.groq.com/keys  (free tier, no card required)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
# Local Ollama (fully offline, no API key): https://ollama.com
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Microsoft Edge neural voice used for speech output (free, no API key).
# Turkish voices: tr-TR-EmelNeural (female), tr-TR-AhmetNeural (male)
AI_TTS_VOICE=tr-TR-EmelNeural
# Language used by the assistant for prompts and replies (tr or en).
AI_LANGUAGE=tr
# Spoken wake word that activates the voice assistant. "fay" is how "Phy" is
# pronounced and it is the form speech recognition transcribes most reliably
# in Turkish; short English style words like "phy" are misheard.
AI_WAKE_WORD=fay
